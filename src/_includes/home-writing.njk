<p><a href="/writing/">All {{ collections.notes.length }} notes →</a></p>
{% for section in [
  { key: "highlights", title: "Highlights", route: "highlights" },
  { key: "lab", title: "Lab notebook", route: "lab-notebook" },
  { key: "problems", title: "Big social problems!", route: "problems" },
  { key: "stories", title: "Stories", route: "stories" },
  { key: "slice-of-life", title: "Slice of life", route: "slice-of-life" },
  { key: "commonplace", title: "Commonplace", route: "commonplace" },
  { key: "unfiled", title: "Everything else", route: "other" }
] %}
<details>
  <summary><a href="/writing/{{ section.route }}/">{{ section.title }}</a> · {{ collections[section.key].length }}</summary>
  <ul>
    {% for note in collections[section.key] %}
    <li><a href="{{ note.url }}">{{ note.data.title or note.fileSlug }}</a></li>
    {% endfor %}
  </ul>
</details>
{% endfor %}
<p><a href="/archive/">Archive graph →</a></p>
